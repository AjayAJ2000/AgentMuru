{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentmuru.dev/agent-pack/v1/agents.schema.json",
  "title": "AgentMuru Agent Pack Agents v1",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "role", "actions", "handoffs"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "role": {"type": "string", "minLength": 1, "maxLength": 512},
      "model_id": {"type": "string", "minLength": 1},
      "actions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}, "uniqueItems": true},
      "handoffs": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "uniqueItems": true}
    }
  }
}
