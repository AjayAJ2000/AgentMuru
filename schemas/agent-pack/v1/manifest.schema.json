{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentmuru.dev/agent-pack/v1/manifest.schema.json",
  "title": "AgentMuru Agent Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "minimum_runtime", "entry_agent", "resource_budget", "provenance"],
  "properties": {
    "schema_version": {"const": "agent-pack.agentmuru.dev/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "minLength": 1},
    "minimum_runtime": {"type": "string", "minLength": 1},
    "entry_agent": {"type": "string", "minLength": 1},
    "resource_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_working_set_bytes", "max_model_bytes", "max_context_tokens", "max_resident_models"],
      "properties": {
        "max_working_set_bytes": {"type": "integer", "minimum": 1},
        "max_model_bytes": {"type": "integer", "minimum": 1},
        "max_context_tokens": {"type": "integer", "minimum": 1},
        "max_resident_models": {"type": "integer", "minimum": 1}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "created_at"],
      "properties": {
        "created_by": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
