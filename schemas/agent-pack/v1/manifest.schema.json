{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agentmuru.dev/agent-pack/v1/manifest.schema.json",
  "title": "AgentMuru Agent Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "entry_agent", "max_hops", "effects"],
  "properties": {
    "schema_version": {"const": "agent-pack.agentmuru.dev/v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "entry_agent": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "max_hops": {"type": "integer", "minimum": 1, "maximum": 32},
    "effects": {"enum": ["simulate", "execute"]}
  }
}
